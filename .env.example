EXPO_PUBLIC_SUPABASE_URL=<SUBSTITUTE_SUPABASE_URL>
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<SUBSTITUTE_SUPABASE_PUBLISHABLE_KEY>
# Dev only: skip auth guards so every route is reachable
EXPO_PUBLIC_BYPASS_AUTH=false
# Names only, never values. Not read by the app:
#   SUPABASE_AUTH_SMS_TWILIO_AUTH_TOKEN   used by the Supabase CLI (supabase/config.toml) once Twilio is connected;
#                                         keep it as a GitHub environment secret, not in this file
