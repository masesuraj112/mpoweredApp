{
  "expo": {
    "name": "MPowered",
    "slug": "mpowered-app",
    "owner": "mpowered-mha",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mpoweredapp",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/mpowered-app-icon.icon",
      "bundleIdentifier": "au.org.mpowered.app"
    },
    "android": {
      "package": "au.org.mpowered.app",
      "adaptiveIcon": {
        "backgroundColor": "#392C5C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#391777",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#391777",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "expo-sqlite",
      "expo-image",
      "expo-web-browser",
      "expo-sharing",
      [
        "expo-notifications",
        {
          "color": "#208AEF",
          "enableRemoteNotifications": false
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "MPowered uses the microphone so you can speak your doctor's answer instead of typing it. Audio is not stored.",
          "speechRecognitionPermission": "MPowered uses speech recognition to turn your spoken words into text on this device."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/456dc2a0-9327-43b1-b5e5-a5a348c15d08"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "456dc2a0-9327-43b1-b5e5-a5a348c15d08"
      }
    }
  }
}
